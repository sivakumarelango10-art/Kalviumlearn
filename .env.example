# KALVI LEARN - Environment Variables Template

# PostgreSQL Connection String (Supabase or standard PostgreSQL)
DATABASE_URL="postgresql://postgres:[YOUR-PASSWORD]@[YOUR-HOST]:5432/postgres"

# Port for Backend Express API
PORT=3000

# Judge0 Sandboxed Execution API
JUDGE0_API_URL="https://ce.judge0.com"

# Supabase Public API (Optional client-side config)
VITE_SUPABASE_URL="https://[YOUR-PROJECT].supabase.co"
VITE_SUPABASE_ANON_KEY="your-anon-key"

# Initial Platform Super Admin
SUPER_ADMIN_EMAIL="codingplatform10@gmail.com"
